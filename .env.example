# Copy to .env.local. Points at your local PostgreSQL (Homebrew default: your macOS user, no password).
DATABASE_URL=postgresql://localhost:5432/qa_career

# Optional (Phase 7): server-side only, used for AI feedback. Leave empty to use manual workflows.
ANTHROPIC_API_KEY=

# Deployments only: lock the whole site behind this password (browser asks once). Leave unset locally.
APP_PASSWORD=
